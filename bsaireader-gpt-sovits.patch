+def _collect_accelerators():
+    """Detect CUDA/ROCm, Intel XPU and Apple MPS without assuming any is present."""
+    global ngpu, if_gpu_ok
+
+    # NVIDIA and AMD ROCm are both exposed through torch.cuda.
+    try:
+        if torch.cuda.is_available():
+            for i in range(torch.cuda.device_count()):
+                gpu_infos.append("%s\t%s" % (i, torch.cuda.get_device_name(i)))
+                props = torch.cuda.get_device_properties(i)
+                mem.append(int(props.total_memory / 1024 / 1024 / 1024 + 0.4))
+                set_gpu_numbers.add(i)
+                if_gpu_ok = True
+    except Exception:
+        pass
+
+    # Intel XPU is optional; torch.xpu does not exist in CPU/CUDA-only builds.
+    try:
+        if hasattr(torch, "xpu") and torch.xpu.is_available():
+            for i in range(torch.xpu.device_count()):
+                gpu_infos.append("%s\t%s" % (i, torch.xpu.get_device_name(i)))
+                props = torch.xpu.get_device_properties(i)
+                mem.append(int(props.total_memory / 1024 / 1024 / 1024 + 0.4))
+                set_gpu_numbers.add(i)
+                if_gpu_ok = True
+    except Exception:
+        pass
+
+    # Apple Metal uses unified memory.
+    try:
+        if hasattr(torch.backends, "mps") and torch.backends.mps.is_available():
+            gpu_infos.append("%s\t%s" % ("0", "Apple GPU"))
+            mem.append(int(psutil.virtual_memory().total / 1024 / 1024 / 1024))
+            set_gpu_numbers.add(0)
+            if_gpu_ok = True
+    except Exception:
+        pass
+
+    ngpu = len(gpu_infos)
+
+
+_collect_accelerators()
 
 
